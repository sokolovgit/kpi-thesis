\NewDocumentCommand \kpiset { m } { \keys_set:nn { kpi } { #1 } }
\cs_new:Npn \kpi@ifmale #1#2 { \tl_if_eq:NnTF \g_kpi_gender_tl {f} {#2} {#1} }

% Plural form of a Ukrainian noun for a number: \kpiplural{n}{рисунок}{рисунки}{рисунків}.
\NewExpandableDocumentCommand \kpiplural { m m m m }
  {
    \int_compare:nNnTF { \int_div_truncate:nn { \int_mod:nn {#1} {100} } {10} } = 1 {#4}
      {
        \int_case:nnF { \int_mod:nn {#1} {10} }
          { {1}{#2} {2}{#3} {3}{#3} {4}{#3} } {#4}
      }
  }
\ExplSyntaxOff

