\newcommand\keywords[1]{\par\noindent КЛЮЧОВІ СЛОВА: \MakeUppercase{#1}.}
\newcommand\keywordsen[1]{\par\noindent KEYWORDS: \MakeUppercase{#1}.}

% «Пояснювальна записка ... містить 36 таблиць, 34 рисунки, 40 джерел та 1 додаток – загалом 102 сторінки.»
\newcommand\kpi@hasappendices{%
  \@ifundefined{kpi@stat@explanatory-note@appendices}{\@secondoftwo}%
    {\ifnum\csname kpi@stat@explanatory-note@appendices\endcsname>0 \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}}
\newcommand\kpiAnnotationStats{%
  містить \kpiCount{explanatory-note}{tables}{таблицю}{таблиці}{таблиць},
  \kpiCount{explanatory-note}{figures}{рисунок}{рисунки}{рисунків}%
  \kpi@hasappendices{, \kpiCount{explanatory-note}{sources}{джерело}{джерела}{джерел}
    та \kpiCount{explanatory-note}{appendices}{додаток}{додатки}{додатків}}%
   { та \kpiCount{explanatory-note}{sources}{джерело}{джерела}{джерел}}
  -- загалом \kpiCount{explanatory-note}{pages}{сторінка}{сторінки}{сторінок};
  графічний матеріал -- \kpiGraphicsSheets~\kpi@sheetsword}
\newcommand\kpi@sheetsword{\@ifundefined{kpi@stat@graphics@pages}{аркушів}%
  {\kpiplural{\numexpr\csname kpi@stat@graphics@pages\endcsname-1\relax}{аркуш}{аркуші}{аркушів}}}
\newcommand\kpi@enplural[3]{\ifnum#1=1 #1 #2\else #1 #3\fi}
\newcommand\kpi@enstat[4]{\@ifundefined{kpi@stat@#1@#2}{?? #4}%
  {\expandafter\kpi@enplural\expandafter{\csname kpi@stat@#1@#2\endcsname}{#3}{#4}}}
\newcommand\kpiAbstractStats{%
  contains \kpi@enstat{explanatory-note}{tables}{table}{tables},
  \kpi@enstat{explanatory-note}{figures}{figure}{figures}%
  \kpi@hasappendices{, \kpi@enstat{explanatory-note}{sources}{reference}{references}
    and \kpi@enstat{explanatory-note}{appendices}{appendix}{appendices}}%
   { and \kpi@enstat{explanatory-note}{sources}{reference}{references}}
  -- \kpi@enstat{explanatory-note}{pages}{page}{pages} in total;
  graphic material -- \kpiGraphicsSheets\ sheets}

