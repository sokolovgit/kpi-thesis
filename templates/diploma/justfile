KPI := '@KPI_THESIS@'
# Ім'я зведеного PDF для здачі — з meta.tex: <прізвище зі student-stamp>_<group>
OUT := `sed -nE 's/^ *student-stamp *= *\{([^ ~}]+).*/\1/p' meta.tex | head -n1` + '_' + `sed -nE 's/^ *group *= *\{([^}]*)\}.*/\1/p' meta.tex | head -n1`
DOCS := 'specification explanatory-note source-code test-plan user-manual graphics'

export PATH := if path_exists('/Library/TeX/texbin') == "true" { '/Library/TeX/texbin:' + env('PATH') } else { env('PATH') }
# check.py prints Cyrillic; Windows consoles default to a legacy code page.
export PYTHONUTF8 := '1'
PYTHON := if os_family() == "windows" { "python" } else { "python3" }

# Список рецептів
default:
    @just --list

# Зібрати один документ: just build explanatory-note
build doc:
    @{{just_executable()}} _tex {{doc}} {{doc}}

# latexmk -silent hides LaTeX's errors: show the first ones from the log. Dropping .fdb_latexmk
# makes the next run rebuild instead of «gave an error in previous invocation».
[private]
_tex dir file *flags:
    #!/usr/bin/env bash
    latexmk -cd -silent {{flags}} "{{dir}}/{{file}}.tex" && exit 0
    rm -f "{{dir}}/build/{{file}}.fdb_latexmk"
    echo "--- помилки з {{dir}}/build/{{file}}.log:" >&2
    grep -m5 -A2 -E '^!|^[^ ]+:[0-9]+: ' "{{dir}}/build/{{file}}.log" >&2 || echo "(див. журнал)" >&2
    exit 1

# Зібрати все й звести в build/<OUT>.pdf (титул збирається останнім — бере числа з інших)
all:
    #!/usr/bin/env bash
    set -euo pipefail
    for d in {{DOCS}}; do "{{just_executable()}}" _tex $d $d; done
    "{{just_executable()}}" _tex title title -g
    mkdir -p build
    pdfs="title/build/title.pdf $(for d in {{DOCS}}; do printf '%s/build/%s.pdf ' $d $d; done)"
    if command -v pdfunite >/dev/null; then
      pdfunite $pdfs "build/{{OUT}}.pdf"
    else
      # no poppler: merge with LuaLaTeX itself, each page keeping its own size (A3 sheets stay A3)
      { echo '\documentclass{article}\usepackage{graphicx}\hoffset=-1in\voffset=-1in'
        echo '\newcount\pgs\newcount\pg\def\addpdf#1{\saveimageresource{#1}\pgs=\lastsavedimageresourcepages\pg=0'
        echo '\loop\ifnum\pg<\pgs\advance\pg 1\setbox0\hbox{\includegraphics[page=\the\pg]{#1}}'
        echo '\pagewidth=\wd0\pageheight=\ht0\shipout\box0\repeat}'
        echo '\begin{document}'
        for f in $pdfs; do echo "\\addpdf{../$f}"; done
        echo '\end{document}'; } > build/merge.tex
      (cd build && lualatex -interaction=batchmode merge.tex >/dev/null)
      mv build/merge.pdf "build/{{OUT}}.pdf"
      rm -f build/merge.*
    fi
    echo "-> build/{{OUT}}.pdf"

# Перезбирати документ при кожному збереженні
watch doc:
    latexmk -cd -pvc {{doc}}/{{doc}}.tex

# Перевірки нормоконтролю (порядок джерел, посилання, «де:», десяткові коми, TODO, журнали)
check:
    {{PYTHON}} -I "{{KPI}}/scripts/check.py" .

# Кількість сторінок, рисунків, таблиць, джерел для анотації та відомості
stats:
    {{PYTHON}} -I "{{KPI}}/scripts/check.py" --stats .

# Прибрати проміжні файли разом із PDF
clean:
    rm -rf build */build

# Прибрати лише проміжні файли (після збою чи двох збірок одночасно), PDF лишаються
clean-aux:
    rm -f */build/*.aux */build/*.out */build/*.toc */build/*.fdb_latexmk */build/*.fls */build/*.xdv */build/*.bbl */build/*.bcf */build/*.blg */build/*.run.xml

# Заморозити клас для цієї роботи: копія в tex/, git pull у репозиторії класу її не змінює
freeze:
    @rm -rf tex && cp -R "{{KPI}}/tex" tex && rm -f tex/.repo
    @grep -q TEXINPUTS .latexmkrc || printf '%s\n' "ensure_path('TEXINPUTS', '../tex//');" >> .latexmkrc
    @echo "клас заморожено ($(sed -nE 's/.*ProvidesClass\{kpi-thesis\}\[[^ ]+ (v[0-9.]+).*/\1/p' tex/kpi-thesis.cls)); повернути: rm -rf tex"
